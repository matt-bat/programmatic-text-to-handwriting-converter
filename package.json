{
  "name": "programmatic-text-to-handwriting-converter",
  "version": "1.0.0",
  "description": "Local-first, no-AI text-to-handwriting converter using seeded vector strokes and procedural natural variation, with Markdown input and PDF export.",
  "private": true,
  "type": "module",
  "author": "Matthew Bateman",
  "license": "PolyForm-Noncommercial-1.0.0",
  "homepage": "https://github.com/matt-bat/programmatic-text-to-handwriting-converter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matt-bat/programmatic-text-to-handwriting-converter.git"
  },
  "bugs": {
    "url": "https://github.com/matt-bat/programmatic-text-to-handwriting-converter/issues"
  },
  "funding": "https://ko-fi.com/matt0bat",
  "keywords": [
    "synthetic-handwriting",
    "text-to-handwriting",
    "no-ai",
    "handwriting-generator",
    "procedural-generation",
    "local-first",
    "markdown",
    "pdf-export",
    "ocr",
    "accessibility"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "python3 -m http.server 4173",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "check": "node --check src/app.js && node --check src/handwriting-engine.js && node --check src/profile-store.js && node --test tests/*.test.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1"
  }
}
